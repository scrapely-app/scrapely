{
    "name": "scrapely",
    "version": "1.2.39",
    "description": "Scrapely SDK for building JavaScript and TypeScript Actors",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.mjs",
            "require": "./dist/index.js",
            "default": "./dist/index.js"
        },
        "./package.json": "./package.json",
        "./dist/*.js": "./dist/*.js",
        "./dist/*.mjs": "./dist/*.mjs",
        "./dist/*": "./dist/*.js",
        "./*": "./*"
    },
    "files": [
        "dist",
        "LICENSE",
        "LICENSE-APACHE",
        "NOTICE",
        "CHANGELOG.md"
    ],
    "private": false,
    "homepage": "https://scrape.ly/docs/sdk-node",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/scrapely-app/scrapely.git"
    },
    "bugs": {
        "url": "https://github.com/scrapely-app/scrapely/issues"
    },
    "publishConfig": {
        "registry": "https://registry.npmjs.org",
        "access": "public"
    },
    "scripts": {
        "build": "tsc",
        "prepack": "npm run build"
    },
    "author": "TeraShift GmbH (Scrape.ly)",
    "license": "ISC AND Apache-2.0",
    "dependencies": {
        "@aws-sdk/client-s3": "^3.700.0",
        "@crawlee/browser": "^3.16.0",
        "@crawlee/browser-pool": "^3.16.0",
        "@crawlee/playwright": "^3.16.0",
        "basic-ftp": "^6.2.3",
        "crawlee": "^3.16.0",
        "dockerode": "^4.0.9",
        "ioredis": "^6.0.0",
        "ip-address": "10.3.1",
        "lodash": "^4.18.1",
        "mysql2": "^3.23.1",
        "playwright": "^1.58.2",
        "scrapely-client": "^2.25.9",
        "tar-fs": "2.1.5",
        "ws": "^8.18.0"
    },
    "devDependencies": {
        "@types/dockerode": "^4.0.1",
        "@types/node": "^25.5.0",
        "@types/ws": "^8.5.10",
        "dotenv": "^17.3.1",
        "puppeteer-core": "^24.43.1",
        "tsx": "^4.21.0",
        "typescript": "^5.7.0"
    },
    "overrides": {
        "adm-zip": "^0.6.1",
        "tar-fs": "2.1.5",
        "yargs": "18.1.0",
        "axios": "^1.20.0",
        "brace-expansion": "5.0.9",
        "fast-xml-builder": "^1.2.1",
        "file-type": "^21.3.3",
        "follow-redirects": "^1.16.1",
        "@crawlee/core": {
            "ow": "0.28.2"
        },
        "@crawlee/utils": {
            "ow": "0.28.2"
        },
        "header-generator": {
            "ow": "0.28.2"
        },
        "scrapely-client": {
            "ow": "0.28.2"
        },
        "uuid": "^11.1.1",
        "@inquirer/external-editor": "3.0.3",
        "nanoid": "5.1.16",
        "browserslist": "4.28.7",
        "basic-ftp": "^6.2.3",
        "@asamuzakjp/css-color": "^7.0.1"
    }
}
